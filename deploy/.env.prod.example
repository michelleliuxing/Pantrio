# Copy to /opt/pantrio/.env on the server (chmod 600). Never commit the real file.

# Long random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# The Vercel URL of the frontend, no trailing slash, e.g. https://pantrio.vercel.app
PUBLIC_ORIGIN=

# Google OAuth client (Web application). Authorised redirect URI:
#   ${PUBLIC_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI. Leave empty to run with the fake suggester (no AI calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_DAILY_LIMIT_PER_HOUSEHOLD=60
AI_DAILY_LIMIT_GLOBAL=600

# Pin a specific build for deploys and rollbacks, e.g. ghcr.io/michelleliuxing/pantrio-api:3f2a1b9c0d4e
PANTRIO_API_IMAGE=ghcr.io/michelleliuxing/pantrio-api:latest
