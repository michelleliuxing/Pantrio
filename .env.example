# Copy to .env for local development. .env is git-ignored.

# Google OAuth client (Web application). Authorised redirect URI for local dev:
#   http://localhost:3000/api/auth/google/callback
# Leave empty to use the dev-only sign-in button instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI. Leave the key empty to use the fake ingredient suggester.
OPENAI_API_KEY=
OPENAI_MODEL=
