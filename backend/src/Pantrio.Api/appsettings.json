{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicOrigin": "http://localhost:3000"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "DevLogin": { "Enabled": false }
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "AiPerMinute": 6
  }
}
