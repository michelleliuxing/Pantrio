    "/api/ingredients": {
      "get": {
        "tags": [
          "Ingredients"
        ],
        "operationId": "ListIngredients",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngredientDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
