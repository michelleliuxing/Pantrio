  },
  "components": {
    "schemas": {
      "AisleCategory": {
        "enum": [
          "produce",
          "meat_seafood",
          "dairy_eggs",
          "bakery",
          "pantry",
          "sauces_condiments",
          "spices",
          "international",
          "frozen",
          "drinks",
          "snacks",
          "household",
          "other"
        ]
      },
      "AuthProvidersResponse": {
        "required": [
          "google",
          "devLogin"
        ],
        "type": "object",
        "properties": {
          "google": {
            "type": "boolean"
          },
          "devLogin": {
            "type": "boolean"
          }
        }
      },
      "CatalogueMatch": {
        "required": [
          "ingredientId",
          "name"
        ],
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateIngredientRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AisleCategory"
              }
            ]
          },
          "isStaple": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "defaultUnit": {
            "maxLength": 24,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "aliases": {
            "maxItems": 20,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DevLoginRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 0,
            "type": "string"
          },
          "displayName": {
            "maxLength": 200,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Dimension": {
        "enum": [
          "mass",
          "volume",
          "count",
          "text"
        ]
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HouseholdDto": {
        "required": [
          "id",
          "name",
          "timeZone",
          "hiddenMealSlots",
          "dietaryPrefs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "hiddenMealSlots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MealSlot"
            }
          },
          "dietaryPrefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HouseholdRole": {
        "enum": [
          "owner",
          "editor",
          "viewer"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngredientDto": {
        "required": [
          "id",
          "name",
          "aliases",
          "defaultUnit",
          "category",
          "isStaple"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultUnit": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/AisleCategory"
          },
          "isStaple": {
            "type": "boolean"
          }
        }
      },
      "IngredientSuggestionRequest": {
        "required": [
          "dishName",
          "servings"
        ],
        "type": "object",
        "properties": {
          "dishName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "servings": {
            "maximum": 50,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "notes": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SuggestionMode"
              }
            ]
          },
          "alreadyListed": {
            "maxItems": 100,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "IngredientSuggestionResponse": {
        "required": [
          "servings",
          "ingredients",
          "isFake"
        ],
        "type": "object",
        "properties": {
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SuggestedIngredientDto"
            }
          },
          "isFake": {
            "type": "boolean"
          }
        }
      },
      "MealSlot": {
        "enum": [
          "breakfast",
          "lunch",
          "dinner"
        ]
      },
      "MeResponse": {
        "required": [
          "user",
          "household",
          "role",
          "canDelete"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "household": {
            "$ref": "#/components/schemas/HouseholdDto"
          },
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          },
          "canDelete": {
            "type": "boolean"
          }
        }
      },
      "MethodSource": {
        "enum": [
          "none",
          "custom",
          "ai"
        ]
      },
      "RecipeDto": {
        "required": [
          "id",
          "name",
          "servings",
          "tags",
          "prepMins",
          "notes",
          "methodText",
          "methodSource",
          "sourceUrl",
          "isFavourite",
          "createdAt",
          "updatedAt",
          "ingredients"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "format": "int32"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prepMins": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "methodText": {
            "type": [
              "null",
              "string"
            ]
          },
          "methodSource": {
            "$ref": "#/components/schemas/MethodSource"
          },
          "sourceUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "isFavourite": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeIngredientDto"
            }
          }
        }
      },
      "RecipeIngredientDto": {
        "required": [
          "id",
          "ingredientId",
          "name",
          "quantity",
          "unit",
          "quantityText",
          "optional",
          "isStaple",
          "category",
          "note",
          "sortOrder"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ingredientId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantityText": {
            "type": [
              "null",
              "string"
            ]
          },
          "optional": {
            "type": "boolean"
